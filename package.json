{
  "name": "questbook",
  "version": "1.2.0",
  "description": "Questbook — квестбук для дисциплины: квесты, ритуалы, HUD и напоминания",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/logic.test.js",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:zip": "electron-builder --win zip",
    "release": "bash tools/release.sh"
  },
  "author": "Dmitry",
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-static": "^1.61.0",
    "png-to-ico": "^2.1.8"
  },
  "productName": "Questbook",
  "build": {
    "appId": "com.questbook.app",
    "productName": "Questbook",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/*.png",
      "build/*.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Questbook",
      "runAfterFinish": true,
      "artifactName": "Questbook-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "twipz333",
        "repo": "questbook",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/twipz333/questbook.git"
  }
}
